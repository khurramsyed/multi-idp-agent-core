        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#E7157B;strokeWidth=1.5;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="tools" target="cw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="l0" value="1. Sign in" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="59" y="437" width="74" height="19" as="geometry"/></mxCell>
        <mxCell id="l1" value="1. OAuth code flow" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="272" y="519" width="127" height="19" as="geometry"/></mxCell>
        <mxCell id="l2" value="Federation" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="373" y="607" width="74" height="19" as="geometry"/></mxCell>
        <mxCell id="l3" value="2. Add population, agency_id,&lt;br&gt;role and region claims" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="516" y="755" width="199" height="34" as="geometry"/></mxCell>
        <mxCell id="l4" value="3. Invoke agent&lt;br&gt;+ Cognito access token" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="443" y="384" width="153" height="34" as="geometry"/></mxCell>
        <mxCell id="l5" value="Model inference&lt;br&gt;(agent&amp;#x27;s IAM role)" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="736" y="299" width="127" height="34" as="geometry"/></mxCell>
        <mxCell id="l6" value="4. MCP tool call&lt;br&gt;+ same user token" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="791" y="384" width="120" height="34" as="geometry"/></mxCell>
        <mxCell id="l7" value="5. Re-validate token,&lt;br&gt;strip and inject&lt;br&gt;_caller_token" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="986" y="549" width="147" height="49" as="geometry"/></mxCell>
        <mxCell id="l8" value="Invoke tool" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1056" y="399" width="81" height="19" as="geometry"/></mxCell>
        <mxCell id="l9" value="6a. Fetch record&lt;br&gt;with user token" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1320" y="465" width="114" height="34" as="geometry"/></mxCell>
        <mxCell id="l10" value="6b. IsAuthorizedWithToken&lt;br&gt;(token + record attributes)&lt;br&gt;→ ALLOW / DENY" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1228" y="287" width="186" height="49" as="geometry"/></mxCell>
        <mxCell id="l11" value="7. Validate token,&lt;br&gt;agency backstop" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1423" y="629" width="127" height="34" as="geometry"/></mxCell>
        <mxCell id="l12" value="8. Audit line&lt;br&gt;(sub, tool, record,&lt;br&gt;decision, request ID)" style="text;html=1;align=right;verticalAlign=top;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1061" y="677" width="147" height="49" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Trust boundaries&lt;/b&gt;&lt;br&gt;The user&amp;#x27;s token is validated by AgentCore Runtime, AgentCore Gateway, the interceptor, Verified Permissions and the ECS services.&lt;br&gt;Access is decided by Cedar at the tool boundary, never by the model. Denied and missing records return the same message." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;strokeColor=#AAB7B8;fillColor=#FAFAFA;rounded=1;spacing=8;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="985" width="1000" height="76" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
